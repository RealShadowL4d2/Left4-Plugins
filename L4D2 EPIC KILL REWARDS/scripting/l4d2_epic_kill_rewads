#pragma semicolon 1
#pragma newdecls required

#include <sourcemod>
#include <sdktools>

#define PLUGIN_VERSION "1.2_EPIC_CAMERA"

bool g_bIsCharging[MAXPLAYERS + 1];
float g_fJockeyRideStart[MAXPLAYERS + 1];

public Plugin myinfo = 
{
    name = "Epic Kill Rewards",
    author = "Shadow L4D2",
    description = "Trofeo y cámara 3ra persona por muertes épicas",
    version = PLUGIN_VERSION,
    url = ""
};

public void OnPluginStart()
{
    HookEvent("witch_killed", Event_WitchKilled);
    HookEvent("tank_killed", Event_TankKilled);
    
    HookEvent("charger_charge_start", Event_ChargeStart);
    HookEvent("charger_charge_end", Event_ChargeEnd);
    HookEvent("player_death", Event_PlayerDeath);
    
    HookEvent("tongue_pull_stopped", Event_TongueStopped);
    
    HookEvent("jockey_ride", Event_JockeyRide);
    HookEvent("jockey_ride_end", Event_JockeyRideEnd);
}

public void OnMapStart()
{
    // Nombre de partícula corregido según tu archivo .pcf
    PrecacheParticle("achieved");
}

public void Event_WitchKilled(Event event, const char[] name, bool dontBroadcast)
{
    int attacker = GetClientOfUserId(event.GetInt("userid"));
    if (IsValidSurvivor(attacker)) RewardPlayer(attacker);
}

public void Event_TankKilled(Event event, const char[] name, bool dontBroadcast)
{
    int attacker = GetClientOfUserId(event.GetInt("attacker"));
    if (IsValidSurvivor(attacker)) RewardPlayer(attacker);
}

public void Event_ChargeStart(Event event, const char[] name, bool dontBroadcast)
{
    int client = GetClientOfUserId(event.GetInt("userid"));
    if (client > 0) g_bIsCharging[client] = true;
}

public void Event_ChargeEnd(Event event, const char[] name, bool dontBroadcast)
{
    int client = GetClientOfUserId(event.GetInt("userid"));
    if (client > 0) g_bIsCharging[client] = false;
}

public void Event_PlayerDeath(Event event, const char[] name, bool dontBroadcast)
{
    int victim = GetClientOfUserId(event.GetInt("userid"));
    int attacker = GetClientOfUserId(event.GetInt("attacker"));
    
    if (victim > 0 && IsValidSurvivor(attacker))
    {
        if (GetClientTeam(victim) == 3 && GetEntProp(victim, Prop_Send, "m_zombieClass") == 6)
        {
            char weapon[32];
            event.GetString("weapon", weapon, sizeof(weapon));
            
            if (StrContains(weapon, "melee") != -1 && g_bIsCharging[victim])
            {
                RewardPlayer(attacker);
            }
        }
    }
}

public void Event_TongueStopped(Event event, const char[] name, bool dontBroadcast)
{
    int rescuer = GetClientOfUserId(event.GetInt("rescuer"));
    if (IsValidSurvivor(rescuer))
    {
        char weapon[64];
        GetClientWeapon(rescuer, weapon, sizeof(weapon));
        if (StrEqual(weapon, "weapon_melee"))
        {
            RewardPlayer(rescuer);
        }
    }
}

public void Event_JockeyRide(Event event, const char[] name, bool dontBroadcast)
{
    int victim = GetClientOfUserId(event.GetInt("victim"));
    if (victim > 0) g_fJockeyRideStart[victim] = GetGameTime();
}

public void Event_JockeyRideEnd(Event event, const char[] name, bool dontBroadcast)
{
    int rescuer = GetClientOfUserId(event.GetInt("rescuer"));
    int victim = GetClientOfUserId(event.GetInt("victim"));
    
    if (IsValidSurvivor(rescuer) && victim > 0)
    {
        if (GetGameTime() - g_fJockeyRideStart[victim] <= 1.2) 
        {
            RewardPlayer(rescuer);
        }
    }
}

void RewardPlayer(int client)
{
    float vPos[3];
    GetClientAbsOrigin(client, vPos);
    vPos[2] += 10.0; 

    int particle = CreateEntityByName("info_particle_system");
    if (particle > 0 && IsValidEntity(particle))
    {
        // Nombre de partícula corregido
        DispatchKeyValue(particle, "effect_name", "achieved"); 
        
        TeleportEntity(particle, vPos, NULL_VECTOR, NULL_VECTOR);
        DispatchSpawn(particle);
        ActivateEntity(particle);
        AcceptEntityInput(particle, "Start");

        char sName[32];
        Format(sName, sizeof(sName), "reward_target_%d", client);
        DispatchKeyValue(client, "targetname", sName);

        SetVariantString(sName);
        AcceptEntityInput(particle, "SetParent");
        
        SetVariantString("OnUser1 !self:Kill::4.0:-1");
        AcceptEntityInput(particle, "AddOutput");
        AcceptEntityInput(particle, "FireUser1");
    }

    ClientCommand(client, "thirdpersonshoulder");
    CreateTimer(4.0, Timer_RestoreCamera, GetClientUserId(client), TIMER_FLAG_NO_MAPCHANGE);
}

public Action Timer_RestoreCamera(Handle timer, any userid)
{
    int client = GetClientOfUserId(userid);
    
    if (client > 0 && IsClientInGame(client) && IsPlayerAlive(client))
    {
        ClientCommand(client, "thirdpersonshoulder");
    }
    return Plugin_Stop;
}

bool IsValidSurvivor(int client)
{
    return (client > 0 && client <= MaxClients && IsClientInGame(client) && GetClientTeam(client) == 2);
}

stock int PrecacheParticle(const char[] sEffectName)
{
    static int table = INVALID_STRING_TABLE;
    if (table == INVALID_STRING_TABLE)
    {
        table = FindStringTable("ParticleEffectNames");
    }
    
    int index = FindStringIndex(table, sEffectName);
    if (index == INVALID_STRING_INDEX)
    {
        AddToStringTable(table, sEffectName);
        index = FindStringIndex(table, sEffectName);
    }
    return index;
}
